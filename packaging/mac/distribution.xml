<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>MakeItASaw 0.1.0</title>
    <organization>com.lorenzomazzeo</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>

    <pkg-ref id="com.lorenzomazzeo.makeitasaw.au"/>
    <pkg-ref id="com.lorenzomazzeo.makeitasaw.vst3"/>

    <choices-outline>
        <line choice="com.lorenzomazzeo.makeitasaw.au"/>
        <line choice="com.lorenzomazzeo.makeitasaw.vst3"/>
    </choices-outline>

    <choice id="com.lorenzomazzeo.makeitasaw.au" title="AU Plugin" description="Audio Unit for Logic Pro, GarageBand, and other AU hosts.">
        <pkg-ref id="com.lorenzomazzeo.makeitasaw.au"/>
    </choice>
    <choice id="com.lorenzomazzeo.makeitasaw.vst3" title="VST3 Plugin" description="VST3 for Ableton Live, Reaper, and other VST3 hosts.">
        <pkg-ref id="com.lorenzomazzeo.makeitasaw.vst3"/>
    </choice>

    <pkg-ref id="com.lorenzomazzeo.makeitasaw.au" version="0.1.0" onConclusion="none">MakeItASaw-AU.pkg</pkg-ref>
    <pkg-ref id="com.lorenzomazzeo.makeitasaw.vst3" version="0.1.0" onConclusion="none">MakeItASaw-VST3.pkg</pkg-ref>
</installer-gui-script>
